{
  "name": "pw-framework",
  "version": "1.0.0",
  "description": "E2E framework with Playwright, Allure Report and AI Agents",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:accessibility": "playwright test --grep @accessibility",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.10.2",
    "eslint": "^10.12.0"
  }
}
